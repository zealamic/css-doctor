{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "Cargo.toml",
    "Cargo.lock",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "turbo.json",
    "biome.json",
    ".cargo/config.toml"
  ],
  "globalEnv": [
    "CARGO_BUILD_TARGET",
    "CARGO_BUILD_JOBS",
    "CARGO_INCREMENTAL",
    "RUSTFLAGS",
    "RUSTUP_TOOLCHAIN",
    "NAPI_RS_FORCE_WASI",
    "TARGET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "public/**",
        "*.html",
        "tsconfig.json",
        "tsup.config.*",
        "vite.config.*",
        "next.config.*",
        "nuxt.config.*",
        "build.rs",
        "Cargo.toml",
        "package.json",
        "!node_modules/**",
        "!.turbo/**",
        "!dist/**",
        "!test/**",
        "!tests/**",
        "!examples/**",
        "!coverage/**",
        "!index.js",
        "!index.d.ts",
        "!index.d.cts",
        "!index.node",
        "!*.node"
      ],
      "outputs": [
        "dist/**",
        "*.node",
        "index.node",
        "index.js",
        "index.d.ts",
        "index.d.cts"
      ]
    },
    "typecheck": {
      "dependsOn": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "tests/**",
        "*.ts",
        "*.tsx",
        "tsconfig.json",
        "package.json",
        "!node_modules/**",
        "!.turbo/**",
        "!dist/**",
        "!coverage/**",
        "!examples/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "tests/**",
        "*.ts",
        "*.tsx",
        "*.html",
        "package.json",
        "tsconfig.json",
        "Cargo.toml",
        "build.rs",
        "!node_modules/**",
        "!.turbo/**",
        "!dist/**",
        "!coverage/**",
        "!index.js",
        "!index.d.ts",
        "!index.d.cts",
        "!index.node",
        "!*.node"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "*.ts",
        "*.tsx",
        "tsconfig.json",
        "package.json",
        "!node_modules/**",
        "!.turbo/**",
        "!dist/**",
        "!index.js",
        "!index.d.ts",
        "!index.d.cts",
        "!index.node",
        "!*.node"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "cache": true,
      "outputs": []
    },
    "check": {
      "cache": true,
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "RUSTUP_HOME",
    "HOME",
    "PNPM_HOME",
    "XDG_DATA_HOME",
    "XDG_CACHE_HOME",
    "npm_config_store_dir"
  ]
}
