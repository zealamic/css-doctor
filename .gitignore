# -----------------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db

.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Environment & local secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------------------------------------
# Node.js / pnpm / package managers
# -----------------------------------------------------------------------------
**/node_modules/
**/.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.*
.yarn/
package-lock.json
yarn.lock

# Bundler / framework caches
.next/
out/
.turbo/
.vercel/
.netlify/
.cache/
.vite/
.parcel-cache/
storybook-static/

# Build output
dist/
*.tsbuildinfo
*.tgz

# Test output
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.eslintcache
.stylelintcache

# -----------------------------------------------------------------------------
# Rust / Cargo
# -----------------------------------------------------------------------------
target/
debug/
*.rs.bk
*.pdb
*.profraw
*.profdata
lcov.info
**/mutants.out*/
rustc-ice-*.txt

# -----------------------------------------------------------------------------
# NAPI-RS generated artifacts
# Keep the native build reproducible; regenerate with:
#   pnpm --filter @zealamic/css-doctor-binding build
# -----------------------------------------------------------------------------
*.node
.napi-rs/
packages/binding/index.js
packages/binding/index.d.ts
packages/binding/index.d.cts

# -----------------------------------------------------------------------------
# Logs / temporary files
# -----------------------------------------------------------------------------
*.log
*.pid

# -----------------------------------------------------------------------------
# Agent local state
# Committed agent configuration lives in:
#   AGENTS.md, CLAUDE.md, .agents/skills, .claude/skills, .cursor/rules
# Only ignore machine-local state below.
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/cache/
.claude/todos/
.claude/shell-snapshots/
.claude/projects/
.codex/
.cursor/cache/
.cursor/chats/
.cursor/*.local
.agents/.local/

# -----------------------------------------------------------------------------
# JetBrains template (kept from upstream gitignore)
# -----------------------------------------------------------------------------
# .idea/ is already ignored above.
