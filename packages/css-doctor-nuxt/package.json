{
  "name": "@zealamic/css-doctor-nuxt",
  "version": "1.0.1",
  "type": "module",
  "description": "Official Nuxt 4 module for css-doctor",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README_VI.md",
    "README_CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "check": "biome check src",
    "prepack": "pnpm build",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@zealamic/css-doctor-vite": "workspace:*"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "nuxt": ">=3.0.0",
    "@nuxt/schema": ">=3.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.2",
    "nuxt": "^4.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@nuxt/schema": "^4.6.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealamic/css-doctor.git",
    "directory": "packages/css-doctor-nuxt"
  },
  "bugs": {
    "url": "https://github.com/zealamic/css-doctor/issues"
  },
  "homepage": "https://github.com/zealamic/css-doctor#readme"
}
