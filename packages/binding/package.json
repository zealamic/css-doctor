{
  "name": "@zealamic/css-doctor-binding",
  "version": "1.0.1",
  "description": "Native Node.js bindings for the css-doctor CSS analysis engine",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealamic/css-doctor.git",
    "directory": "packages/binding"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md",
    "README_VI.md",
    "README_CN.md"
  ],
  "napi": {
    "name": "css-doctor-binding",
    "triples": {
      "defaults": true
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "pnpm build && pnpm typecheck && tsx test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src test.ts",
    "format": "biome format --write src test.ts",
    "format:check": "biome format src test.ts",
    "check": "biome check src test.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@zealamic/css-doctor-binding-darwin-arm64": "workspace:*",
    "@zealamic/css-doctor-binding-darwin-x64": "workspace:*",
    "@zealamic/css-doctor-binding-linux-x64-gnu": "workspace:*",
    "@zealamic/css-doctor-binding-linux-x64-musl": "workspace:*",
    "@zealamic/css-doctor-binding-win32-x64-msvc": "workspace:*"
  },
  "bugs": {
    "url": "https://github.com/zealamic/css-doctor/issues"
  },
  "homepage": "https://github.com/zealamic/css-doctor#readme"
}
