{
  "name": "@zealamic/css-doctor-next",
  "version": "1.0.1",
  "type": "module",
  "description": "Next.js integration for css-doctor page-coverage CSS splitting",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_VI.md",
    "README_CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm build && tsx --test test/next-plugin.test.ts",
    "test:next": "pnpm build && tsx --test test/next-build.test.ts",
    "lint": "biome lint src examples test/next-plugin.test.ts test/next-build.test.ts",
    "format": "biome format --write src examples test/next-plugin.test.ts test/next-build.test.ts",
    "format:check": "biome format src examples test/next-plugin.test.ts test/next-build.test.ts",
    "check": "biome check src examples test/next-plugin.test.ts test/next-build.test.ts"
  },
  "dependencies": {
    "@zealamic/css-doctor-binding": "workspace:*",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "next": "^15.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealamic/css-doctor.git",
    "directory": "packages/css-doctor-next"
  },
  "bugs": {
    "url": "https://github.com/zealamic/css-doctor/issues"
  },
  "homepage": "https://github.com/zealamic/css-doctor#readme"
}
