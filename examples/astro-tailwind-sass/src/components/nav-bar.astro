---
type NavItem = {
  label: string;
  href: string;
};

const navItems: NavItem[] = [
  { label: "Astro (Home)", href: "/" },
  { label: "React", href: "/page-react" },
  { label: "Vue", href: "/page-vue" },
  { label: "Svelte", href: "/page-svelte" },
  { label: "Preact", href: "/page-preact" },
  { label: "Solid", href: "/page-solid" },
];

const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 z-50 flex items-center justify-between border-b border-slate-800 bg-slate-950/80 px-8 py-4 backdrop-blur">
  <div class="bg-gradient-to-r from-purple-400 via-pink-400 to-indigo-400 bg-clip-text text-xl font-bold text-transparent">
    Astro Multi-Island Stress Test
  </div>
  <div class="flex gap-4">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`rounded-md px-3 py-1.5 text-sm transition-colors ${
          currentPath === item.href
            ? "border border-purple-500/30 bg-purple-600/20 font-semibold text-purple-300"
            : "text-slate-400 hover:text-white"
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>
