{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedDeclarations": false,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src", "rsbuild.config.ts"]
}
